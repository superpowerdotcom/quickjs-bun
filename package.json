{
  "name": "quickjs-bun",
  "version": "0.2.0",
  "description": "Lightweight, fully-featured, idiomatic bun:ffi bindings to QuickJS.",
  "keywords": [
    "bun",
    "bun-ffi",
    "embedded",
    "ffi",
    "javascript",
    "quickjs",
    "sandbox",
    "vm"
  ],
  "homepage": "https://github.com/superpowerdotcom/quickjs-bun#readme",
  "bugs": {
    "url": "https://github.com/superpowerdotcom/quickjs-bun/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kenta Iwasaki",
    "url": "https://github.com/lithdew"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superpowerdotcom/quickjs-bun.git"
  },
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "index.ts",
    "src",
    "quickjs/LICENSE",
    "quickjs/VERSION",
    "quickjs/*.c",
    "quickjs/*.h"
  ],
  "type": "module",
  "module": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "mkdir -p build && cc -O2 -shared -fPIC -DNDEBUG -D_GNU_SOURCE=1 -DCONFIG_VERSION=\"\\\"$(cat quickjs/VERSION)\\\"\" -Isrc/native -Iquickjs src/native/quickjs.c quickjs/cutils.c quickjs/libunicode.c quickjs/libregexp.c quickjs/dtoa.c src/native/alloca.S -lm -o build/quickjs-bun.$(bun -e 'console.log(require(\"bun:ffi\").suffix)')",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "stress": "bun scripts/stress.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
